{
  "name": "@globalise/mcp",
  "version": "0.1.0",
  "description": "MCP server for the GLOBALISE VOC archives: transcriptions, annotations and reference data",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "globalise-mcp": "./dist/stdio.js",
    "globalise-mcp-http": "./dist/http.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/stdio.ts",
    "start:http": "node src/http.ts",
    "dev:http": "node --watch src/http.ts",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector node src/stdio.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/globalise-huygens/globalise-mcp.git"
  },
  "homepage": "https://github.com/globalise-huygens/globalise-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "openseadragon": "^6.1.1",
    "srvx": "^1.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.12.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
    }
  }
}
